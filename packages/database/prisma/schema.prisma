
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  balance   BigInt   @default(500000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
