generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid())
  name     String?
  email    String  @unique
  password String

  balance   BigInt    @default(500000)
  accounts  Account[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model MarketQuote {
  ingestId          BigInt    @default(dbgenerated("nextval('public.market_quotes_ingest_id_seq'::regclass)")) @map("ingest_id")
  receivedAt        DateTime  @map("received_at") @db.Timestamptz(6)
  exchangeEventTime DateTime? @map("exchange_event_time") @db.Timestamptz(6)
  asset             String
  bidPrice          BigInt    @map("bid_price")
  askPrice          BigInt    @map("ask_price")
  bidQuantity       BigInt    @map("bid_quantity")
  askQuantity       BigInt    @map("ask_quantity")
  updateId          BigInt    @map("update_id")

  @@id([asset, receivedAt, updateId])
  @@index([asset, receivedAt(sort: Desc)], map: "idx_market_quotes_asset_received")
  @@index([ingestId], map: "idx_market_quotes_ingest_id")
  @@map("market_quotes")
}

model MarketCandle {
  asset           String
  interval        String
  startTime       DateTime @map("start_time") @db.Timestamptz(6)
  bidOpen         BigInt   @map("bid_open")
  bidHigh         BigInt   @map("bid_high")
  bidLow          BigInt   @map("bid_low")
  bidClose        BigInt   @map("bid_close")
  askOpen         BigInt   @map("ask_open")
  askHigh         BigInt   @map("ask_high")
  askLow          BigInt   @map("ask_low")
  askClose        BigInt   @map("ask_close")
  quoteCount      BigInt   @map("quote_count")
  firstReceivedAt DateTime @map("first_received_at") @db.Timestamptz(6)
  firstUpdateId   BigInt   @map("first_update_id")
  lastReceivedAt  DateTime @map("last_received_at") @db.Timestamptz(6)
  lastUpdateId    BigInt   @map("last_update_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([asset, interval, startTime])
  @@index([interval, startTime(sort: Desc)], map: "idx_market_candles_interval_start")
  @@map("market_candles")
}

model CandleAggregationCheckpoint {
  consumerName String   @id @map("consumer_name")
  lastIngestId BigInt   @default(0) @map("last_ingest_id")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("candle_aggregation_checkpoint")
}

// financial asset
enum AccountType {
  DEMO
}

model Account {
  id          String      @id @default(uuid())
  userId      String
  accountType AccountType @default(DEMO)
  currency    String      @default("USD")

  availableBalance BigInt @default(0)
  lockedBalance    BigInt @default(0)

  user User @relation(fields: [userId], references: [id])

  orders        Order[]
  positions     Position[]
  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, accountType, currency])
}

model Order {
  id        String @id @default(uuid())
  accountId String

  asset   String
  side    OrderSide
  purpose OrderPurpose

  quantity BigInt

  status OrderStatus @default(PENDING)

  // Used for CLOSE orders
  positionId String?

  // Used to identify successful execution
  executionPrice BigInt?

  // Client retry protection
  idempotencyKey String?

  rejectionReason String?

  requestedAt DateTime  @default(now())
  executedAt  DateTime?

  account Account @relation(fields: [accountId], references: [id])

  targetPosition Position? @relation("CloseOrders", fields: [accountId, positionId], references: [accountId, id])

  openedPosition Position? @relation("OpeningOrder")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, idempotencyKey])
  @@unique([accountId, id])
  @@index([accountId, status, createdAt])
  @@index([status, createdAt])
}

model Position {
  id        String @id @default(uuid())
  accountId String

  // Asset and trade direction
  asset     String
  direction PositionDirection
  quantity  BigInt

  // Execution details
  entryPrice BigInt
  exitPrice  BigInt?

  // Financial details
  reservedAmount BigInt
  realizedPnl    BigInt?

  // Lifecycle
  status PositionStatus @default(OPEN)

  // Opening order reference
  openOrderId String @unique

  // Relations
  account Account @relation(fields: [accountId], references: [id])

  openingOrder Order @relation("OpeningOrder", fields: [accountId, openOrderId], references: [accountId, id])

  closeOrders Order[] @relation("CloseOrders")

  openedAt DateTime  @default(now())
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, id])
  @@unique([accountId, openOrderId])
  @@index([accountId, status, openedAt])
  @@index([asset, status])
}

model LedgerEntry {
  id        String @id @default(uuid())
  accountId String

  // Groups entries belonging to one financial operation
  operationId String @db.Uuid

  entryType LedgerEntryType
  bucket    LedgerBucket

  // Signed amount in cents
  amount BigInt

  referenceId String?
  description String?

  account Account @relation(fields: [accountId], references: [id])

  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([operationId])
  @@index([referenceId])
}

model ProcessedCommand {
  // Unique ID received from Redis Streams
  commandId String @id

  commandType CommandType
  outcome     CommandOutcome

  // Position or order associated with the command
  aggregateId String?

  // Optional execution/rejection result
  result Json?

  processedAt DateTime @default(now())

  @@index([commandType, processedAt])
}

model OutboxEvent {
  id String @id @default(uuid())

  eventType   String
  destination OutboxDestination

  // Related order or position ID
  aggregateId String

  // Message to publish
  payload Json

  status OutboxStatus @default(PENDING)

  // Retry management
  attempts    Int      @default(0)
  availableAt DateTime @default(now())

  lastError   String?
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([destination, status, availableAt])
  @@index([aggregateId])
}

enum OrderSide {
  BUY
  SELL
}

enum OrderPurpose {
  OPEN
  CLOSE
}

enum OrderStatus {
  PENDING
  EXECUTED
  REJECTED
}

enum PositionDirection {
  LONG
  SHORT
}

enum PositionStatus {
  OPEN
  CLOSE_PENDING
  CLOSED
}

enum LedgerBucket {
  AVAILABLE
  LOCKED
}

enum LedgerEntryType {
  INITIAL_FUNDING
  RESERVE
  RELEASE
  REALIZED_PNL
}

enum CommandType {
  OPEN_POSITION
  CLOSE_POSITION
}

enum CommandOutcome {
  EXECUTED
  REJECTED
}

enum OutboxDestination {
  ORDER_COMMANDS
  TRADE_EVENTS
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  DEAD_LETTER
}
