# PostgreSQL (replace the placeholder password before starting Docker)
POSTGRES_USER=replace_with_local_user
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=exness_v0
POSTGRES_PORT=5432
DATABASE_URL="postgresql://replace_with_local_user:replace-with-a-local-password@localhost:5432/exness_v0?schema=public"

# API
API_PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
