# PostgreSQL (replace the placeholder password before starting Docker)
POSTGRES_USER=replace_with_local_user
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=exness_v0
POSTGRES_PORT=5432
DATABASE_URL="postgresql://replace_with_local_user:replace-with-a-local-password@localhost:5432/exness_v0?schema=public"

# API
API_PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
# Generate a random secret with: bun -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('base64url'))"
JWT_SECRET=
